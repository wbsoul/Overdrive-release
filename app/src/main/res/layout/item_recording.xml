<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Selection Checkbox (hidden by default, shown in select mode) -->
        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:buttonTint="@color/brand_primary" />

        <!-- Video Thumbnail with Play Overlay -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/calendar_day_bg_has_recordings"
                android:contentDescription="Video thumbnail"
                android:scaleType="centerCrop" />

            <!-- Play icon overlay -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                android:alpha="0.9"
                android:contentDescription="Play" />

        </FrameLayout>

        <!-- Recording Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Type badge + AI badges + filename -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Type badge: SENTRY / PROXIMITY / NORMAL -->
                <TextView
                    android:id="@+id/tvTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/calendar_day_bg_selected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/bg_base"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    tools:text="SENTRY" />

                <!-- AI detection badges (person / car / bike) — shown only for sentry events -->
                <TextView
                    android:id="@+id/tvAiBadge1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="🚶 87%" />

                <TextView
                    android:id="@+id/tvAiBadge2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="🚗 65%" />

                <TextView
                    android:id="@+id/tvAiBadge3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="🚲 42%" />

            </LinearLayout>

            <!-- Row 2: Filename -->
            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="event_20260515_134544.mp4" />

            <!-- Row 3: Date · Time · Size -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="May 15, 2026" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/recording_indicator_dot" />

                <TextView
                    android:id="@+id/tvRecordingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="1:45 PM" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/recording_indicator_dot" />

                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="10.3 MB" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Play Button -->
            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/brand_primary" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_danger" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
