<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Registration Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Companion App Status"
                    android:textAppearance="@style/TextAppearance.Overdrive.Subtitle"
                    android:layout_marginBottom="16dp" />

                <!-- Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvFcmStatusDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvFcmStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not registered"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Last updated (only visible when registered) -->
                <TextView
                    android:id="@+id/tvFcmUpdatedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register from the OverDrive Companion app on your phone"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Remove button (only visible when registered) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFcmRemoveDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove registered device"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Master Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔 Push Notifications"
                    android:textAppearance="@style/TextAppearance.Overdrive.Subtitle"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmMaster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable push notifications"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send alerts to the OverDrive Companion app"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginStart="48dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Per-event Toggles Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFcmEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Events to push"
                    android:textAppearance="@style/TextAppearance.Overdrive.Subtitle"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmMotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Motion Detection"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmCritical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Critical Alerts"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmTunnel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tunnel URL Changes"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video Ready"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFcmProximity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Proximity Alerts"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingVertical="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
